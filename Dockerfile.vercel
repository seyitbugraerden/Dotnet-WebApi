FROM mcr.microsoft.com/dotnet/sdk:3.1 AS build
WORKDIR /src
COPY shopapp.entity/ shopapp.entity/
COPY shopapp.data/ shopapp.data/
COPY shopapp.business/ shopapp.business/
COPY shopapp.webapi/ shopapp.webapi/
WORKDIR /src/shopapp.webapi
RUN dotnet publish shopapp.webapi.csproj -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:3.1 AS runtime
WORKDIR /app
COPY --from=build /app/publish .
ENV ASPNETCORE_ENVIRONMENT=Production
EXPOSE 80
CMD ["sh", "-c", "exec dotnet shopapp.webapi.dll --urls http://0.0.0.0:${PORT:-80}"]
